# ==============================================================================
# TOKUFLIX CLIENT-SIDE CONFIGURATION (PUBLIC ENVIRONMENT VARIABLES)
# ==============================================================================
# PERINGATAN KEAMANAN:
# Seluruh variabel berawalan VITE_* akan dibundel ke frontend dan DAPAT DILIHAT
# oleh browser setiap pengguna. JANGAN PERNAH menaruh API secret, private key,
# password database, atau kredensial server rahasia di file ini!

# 1. Base URL API Streaming & Katalog Tokuflix (Client-Side Direct Fetch)
# Diisi dengan URL REST API streaming Anda (misal: https://api.domain-anda.com/api/v1 atau http://localhost:3000/api/v1)
# Jika dikosongkan, aplikasi otomatis menggunakan Local In-Memory Canonical Engine (100% Offline Resilience).
# CATATAN CORS: Server API Anda harus mengaktifkan header 'Access-Control-Allow-Origin' agar browser dapat mengaksesnya langsung.
VITE_API_BASE_URL=

# 2. TMDB (The Movie Database) API Key v3
# Dapatkan gratis di https://www.themoviedb.org/settings/api
# Request pencarian dan sinkronisasi metadata TMDB dikirim langsung dari browser pengguna ke api.themoviedb.org
VITE_TMDB_API_KEY=
